{
  "name": "cellular-world",
  "version": "1.0.0",
  "description": "A continuous mathematical film about cellular automata, rendered with Multiplane.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "multiplane lint film.html --json",
    "test": "node scripts/test-simulation.cjs",
    "stills": "multiplane stills film.html --at 12,45,83,119,155,190,228,264,300,337 --out output/review/keyframes --json",
    "verify": "multiplane verify film.html --at 12,45,83,119,155,190,228,264,300,337 --workers 2 --json",
    "render": "sh scripts/render-final.sh",
    "preview": "multiplane serve --port 18721",
    "mix": ".venv/bin/python scripts/soundtrack.py",
    "align": ".venv/bin/python scripts/align.py"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "katex": "0.19.0",
    "multiplane": "0.3.8"
  },
  "private": true
}
